# 软考报名提醒 —— Nginx 站点配置示例
#
# 用法：
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ruankao
#   sudo ln -s /etc/nginx/sites-available/ruankao /etc/nginx/sites-enabled/
#   # 把下面的 ruankao.agentctxs.com 换成你的域名
#   sudo nginx -t && sudo systemctl reload nginx
#
# 然后申请证书（certbot 会自动改写本文件，补上 443 与跳转）：
#   sudo certbot --nginx -d ruankao.agentctxs.com
#
# 关键点：server_name 必须与你的域名完全一致。写错或漏写的话，请求会落到
# 同一台机器上的其它站点（或默认站点）上，表现为 404 或证书主体名不匹配。

server {
    listen 80;
    listen [::]:80;
    server_name ruankao.agentctxs.com;

    # certbot 的 HTTP-01 校验走这里，不要拦
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 证书尚未就绪时先只放行校验路径，避免泄漏明文流量。
    # 证书申请完成后，certbot 会自动插入 301 跳转，这两行可以删掉。
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ruankao.agentctxs.com;

    # certbot 会自动填好下面这两行。手动部署时把路径换成自己的证书。
    # ssl_certificate     /etc/letsencrypt/live/ruankao.agentctxs.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ruankao.agentctxs.com/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 站点不发 Cookie 给第三方，也没有外链资源，这几个头开销极小
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # 邮件里的链接会带一长串 token，别让它出现在别人服务器的日志里
    access_log /var/log/nginx/ruankao.access.log;

    client_max_body_size 1m;          # 表单很小，超出的一律不是正常用户

    location /static/ {
        # 静态资源直接由 Nginx 送出，不经过 Python
        alias /srv/ruankao/ruankao/static/;
        expires 7d;
        access_log off;
    }

    # 后台只有一个口令保护，建议再叠一层来源限制。
    # 取消下面两行的注释，把网段换成你自己的。
    # location /admin {
    #     allow 203.0.113.0/24;
    #     deny  all;
    #     proxy_pass http://127.0.0.1:3000;
    # }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 应用里的限流依赖这个头取真实 IP，漏配会导致所有人都被当成同一个来源
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
