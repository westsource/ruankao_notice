# 软考报名提醒 —— systemd 服务单元
#
# 用法：
#   sudo cp deploy/ruankao.service /etc/systemd/system/
#   # 按需修改下面的 User / WorkingDirectory / EnvironmentFile
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ruankao
#   sudo systemctl status ruankao
#   journalctl -u ruankao -f          # 看日志
#
# 部署前先确认这两件事，否则服务起来了但发不出信：
#   1. .env 里 SITE_URL 是真实的 https 域名
#   2. data/ 目录属于运行用户，且已纳入备份

[Unit]
Description=软考报名提醒
Documentation=https://github.com/westsource/ruankao_notice
After=network-online.target
Wants=network-online.target

# 崩溃后的重启限流。注意：这两个键属于 [Unit] 段，写进 [Service] 会被 systemd
# 当成未知键**静默忽略**（只在 journal 里留一行 warning），限流实际不生效。
# 实测踩过：服务照跑，但"5 分钟内最多重启 5 次"这条根本没起作用。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ruankao
Group=ruankao
WorkingDirectory=/srv/ruankao

EnvironmentFile=/srv/ruankao/.env

# 用 waitress，单进程同时承担 HTTP 与定时任务
ExecStart=/srv/ruankao/.venv/bin/python run.py

# 时区必须固定。定时任务是按钟点触发的，跟着宿主机漂到 UTC 就会在半夜发信。
Environment=TZ=Asia/Shanghai

Restart=always
RestartSec=5

# 最小权限：这个服务只需要自己的目录和网络
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ruankao

[Install]
WantedBy=multi-user.target
