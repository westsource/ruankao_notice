# ---------------------------------------------------------------------------
# 软考报名提醒 — 环境配置
# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会进仓库。
# ---------------------------------------------------------------------------

# 站点
SITE_NAME=软考报名提醒
SITE_URL=http://localhost:3000
PORT=3000
FLASK_DEBUG=false

# 对外公布的运营方信息，出现在页脚与邮件底部。留空则不展示。
SITE_OPERATOR=
SITE_CONTACT_EMAIL=

# 用于签署后台登录态。请改成一串随机字符，例如 python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 数据库（SQLite 文件路径，相对项目根目录或绝对路径）
DB_PATH=data/ruankao.db

# ---------------------------------------------------------------------------
# 邮件发信
#
# 这是本站唯一的通知通道。个人邮箱 SMTP 每日限额较低（几十到几百封），
# 用户量上来建议改用腾讯企业邮或专业推送服务。
# 务必配好发件域名的 SPF 与 DKIM，否则大概率进垃圾箱——README 里有说明。
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=软考报名提醒 <noreply@example.com>

# 说明：本项目不提供短信通道。
# 国内短信签名报备要求企业或个体工商户主体，个人主体无法通过运营商的
# 实名报备（腾讯云自 2025-09-18 起不再受理个人自用资质；阿里云亦明确
# 「个人认证自用资质无法通过签名实名制报备」）。既然发不出去，就不在
# 代码里留一条永远走不通的路径。

# ---------------------------------------------------------------------------
# 后台与告警
# ADMIN_TOKEN 用于登录 /admin，务必改成足够长的随机串
# ---------------------------------------------------------------------------
ADMIN_TOKEN=change-me-please
ALERT_EMAIL=

# 每日抓取时刻（24 小时制，逗号分隔）。报名开放当天可临时改密一些。
SCRAPE_TIMES=08:10,20:10

# 是否在本进程内启动定时任务。用 gunicorn 多 worker 部署时务必设为 false，
# 否则每个 worker 都会跑一遍，任务会重复执行。
SCHEDULER_ENABLED=true

# 开发用：不发真实邮件，只把通知内容写进日志
DRY_RUN=false
