# 统一行尾：仓库内一律 LF，避免 Windows 提交把整个文件标记成改动
* text=auto eol=lf

*.py       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.example  text eol=lf
*.sql      text eol=lf
Dockerfile text eol=lf
LICENSE    text eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.ico  binary
*.db   binary
*.zip  binary
